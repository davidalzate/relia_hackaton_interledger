{
  "name": "relia-rail-proxy",
  "version": "0.1.0",
  "private": true,
  "description": "Adaptador de riel de Relia sobre Open Payments. Implementa contracts/rail-proxy.openapi.yaml.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.2.1",
    "@interledger/open-payments": "^7.4.0",
    "better-sqlite3": "^12.0.0",
    "fastify": "^5.12.7",
    "pino": "^10.4.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  }
}
