# Copiar a .env (no se versiona) y completar.

# Clave compartida con el backend .NET (header X-Api-Key).
RAIL_PROXY_API_KEY=

# Billetera de Relia: payment pointer o URL https.
RELIA_WALLET_ADDRESS=$ilp.interledger-test.dev/relia-test1

# Developer key de la billetera de Relia (wallet de prueba → Settings → Developer Keys).
RELIA_KEY_ID=
# El archivo private.key en base64:  base64 -i private.key | tr -d '\n'
RELIA_PRIVATE_KEY_BASE64=

# Opcionales
# HOST=0.0.0.0
# PORT=4000
# LOG_LEVEL=info
# DATABASE_PATH=data/rail-proxy.db
# HEALTH_RATE_LIMIT_PER_MINUTE=60
